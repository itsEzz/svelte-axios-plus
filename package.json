{
	"name": "svelte-axios-plus",
	"version": "2.0.0",
	"description": "A Svelte-optimized Axios wrapper that provides reactive request handling, built-in caching, and simplified state management for HTTP requests.",
	"license": "MIT",
	"author": "Adrian Gast",
	"homepage": "https://github.com/itsEzz/svelte-axios-plus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itsEzz/svelte-axios-plus.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/svelte-axios-plus/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.svelte.d.ts",
			"svelte": "./dist/index.svelte.js"
		}
	},
	"main": "./dist/index.svelte.js",
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "vp build && npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vp dev",
		"dev-debug": "vavite-loader vite dev",
		"format": "vp fmt .",
		"format-pkg": "prettier-package-json --write ./package.json",
		"lint": "vp fmt --check . && vp lint .",
		"package": "svelte-kit sync && svelte-package && publint",
		"preview": "vp preview",
		"prepublishOnly": "npm run package",
		"test": "vp test",
		"test:coverage": "vp test run --coverage",
		"prepare": "vp config"
	},
	"types": "./dist/index.svelte.d.ts",
	"dependencies": {
		"lru-cache": "^11.5.3"
	},
	"peerDependencies": {
		"axios": ">=1.0.0",
		"svelte": "^5"
	},
	"packageManager": "pnpm@12.16.1",
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@vavite/node-loader": "^5.1.0",
		"@vitest/coverage-v8": "catalog:",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier-package-json": "^2.8.0",
		"publint": "^0.3.24",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vite-plus": "catalog:"
	},
	"keywords": [
		"axios",
		"cache",
		"http-client",
		"requests",
		"svelte",
		"svelte5",
		"typescript"
	],
	"svelte": "./dist/index.svelte.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
