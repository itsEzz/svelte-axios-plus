{
	"name": "svelte-axios-plus",
	"version": "2.0.0",
	"description": "A Svelte-optimized Axios wrapper that provides reactive request handling, built-in caching, and simplified state management for HTTP requests.",
	"license": "MIT",
	"author": "Adrian Gast",
	"homepage": "https://github.com/itsEzz/svelte-axios-plus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itsEzz/svelte-axios-plus.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/svelte-axios-plus/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.svelte.d.ts",
			"svelte": "./dist/index.svelte.js"
		}
	},
	"main": "./dist/index.svelte.js",
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "vite build && npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"dev-debug": "vavite-loader vite dev",
		"format": "prettier --write .",
		"format-pkg": "prettier-package-json --write ./package.json",
		"lint": "prettier --check . && eslint .",
		"package": "svelte-kit sync && svelte-package && publint",
		"preview": "vite preview",
		"prepublishOnly": "npm run package",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"types": "./dist/index.svelte.d.ts",
	"dependencies": {
		"lru-cache": "^11.5.3"
	},
	"peerDependencies": {
		"axios": ">=1.0.0",
		"svelte": "^5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"@vavite/node-loader": "^5.1.0",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-package-json": "^2.8.0",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"keywords": [
		"axios",
		"cache",
		"http-client",
		"requests",
		"svelte",
		"svelte5",
		"typescript"
	],
	"svelte": "./dist/index.svelte.js"
}
